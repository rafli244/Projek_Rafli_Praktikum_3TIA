<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#673AB7"
    tools:context=".Home.HomeFragment">

    <!-- Toolbar Utama -->
    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:background="@drawable/bg_header_wave"
        android:backgroundTint="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#060707"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Home"
        app:titleTextColor="@android:color/white" />

    <!-- Card Title Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTitleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#80000000"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/txtUsername2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="Halaman Main Activity"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/txtUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:fontFamily="sans-serif-medium"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:text="Username"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardTitleContainer" />

    <TextView
        android:id="@+id/txtPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-medium"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:text="Password"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtUsername" />

    <!-- Wadah CardView Utama -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/MaterialCardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#FFCBAF"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtPassword"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="1dp">

        <!-- IMPLEMENTASI GRIDLAYOUT YANG BENAR -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            app:columnCount="2"
            app:useDefaultMargins="true">

            <!-- Tombol SnackBar -->
            <Button
                android:id="@+id/btnSnackBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal"
                android:backgroundTint="#121212"
                android:text="SnackBar"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

            <!-- Tombol Alert -->
            <Button
                android:id="@+id/btnAlert"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal"
                android:backgroundTint="#333333"
                android:text="Alert"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

            <!-- Tombol Lima -->
            <Button
                android:id="@+id/btnToLima"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal"
                android:backgroundTint="#666666"
                android:text="Button Lima"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

            <!-- Tombol Enam -->
            <Button
                android:id="@+id/btnToEnam"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal"
                android:backgroundTint="#444444"
                android:text="Pertemuan 6"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

            <!-- Tombol Pertemuan 9 -->
            <Button
                android:id="@+id/btnToSembilan"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal"
                android:backgroundTint="#444444"
                android:text="Pertemuan 9"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

            <!-- Tombol Pertemuan 10 (BARU) -->
            <Button
                android:id="@+id/btnToSepuluh"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal"
                android:backgroundTint="#4A148C"
                android:text="Pertemuan 10"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

            <!-- Tombol Logout -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal"
                android:backgroundTint="#D32F2F"
                android:text="Logout"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

        </androidx.gridlayout.widget.GridLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>